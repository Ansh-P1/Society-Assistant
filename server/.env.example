# Server
PORT=4000

# Database
DB_URL=postgresql://user:password@localhost:5432/society_tracker

# Auth
JWT_SECRET=change-me

# Email - sent via Nodemailer over plain SMTP, so any SMTP-capable free-tier
# provider works (Gmail app password, Mailtrap, Brevo, ...).
# See docs/EMAIL_SETUP.md for how to get these values.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-address@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=your-address@gmail.com

# Note: the overdue-complaint threshold is admin-configurable at runtime via
# the settings table (see docs/SCHEMA.md), not an env var.
