# Server
PORT=4000

# Database
DB_URL=postgresql://user:password@localhost:5432/society_tracker

# Auth
JWT_SECRET=change-me

# Email (any free-tier SMTP provider, e.g. Gmail app password, Mailtrap, Brevo)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Note: the overdue-complaint threshold is admin-configurable at runtime via
# the settings table (see docs/SCHEMA.md), not an env var.
